{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/package.json",
  "title": "Package.json Configuration",
  "description": "Schema describing the frontend package.json configuration file for the Tent of Trials project.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the package.",
      "pattern": "^[@a-zA-Z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "description": "Package version following semver.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "description": "A brief description of the package."
    },
    "main": {
      "type": "string",
      "description": "The entry point file."
    },
    "scripts": {
      "type": "object",
      "description": "Script commands for the package.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Runtime dependencies.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "object",
      "description": "Development dependencies.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "private": {
      "type": "boolean",
      "description": "Whether the package is private."
    },
    "license": {
      "type": "string",
      "description": "The license identifier."
    },
    "author": {
      "type": "string",
      "description": "The author of the package."
    },
    "repository": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["type", "url"],
      "additionalProperties": false,
      "description": "Repository information."
    },
    "engines": {
      "type": "object",
      "description": "Engine requirements.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["name", "version"],
  "additionalProperties": true
}
