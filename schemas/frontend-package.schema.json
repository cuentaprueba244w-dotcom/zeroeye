{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zeroeye.app/frontend-package.schema.json",
  "title": "Frontend Package JSON",
  "description": "Schema for the frontend package.json file",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "private": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["name", "version"]
}
