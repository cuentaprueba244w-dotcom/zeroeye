{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cuentaprueba244w-dotcom/zeroeye/schemas/project-config.json",
  "title": "ZeroEye Project Configuration",
  "description": "JSON Schema describing the frontend package.json configuration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "NPM scripts"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Runtime dependencies"
    }
  },
  "required": ["name", "version"],
  "additionalProperties": true
}