{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tent of Trials Project Data",
  "type": "object",
  "required": [
    "project",
    "version",
    "modules"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "tool"
            ]
          },
          "language": {
            "type": "string"
          },
          "build_cmd": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}