{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frontend Package Config",
  "type": "object",
  "required": [
    "name",
    "version"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^@?[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "private": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object"
    },
    "devDependencies": {
      "type": "object"
    },
    "peerDependencies": {
      "type": "object"
    },
    "engines": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "npm": {
          "type": "string"
        }
      }
    },
    "browserslist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}