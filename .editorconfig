root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.rs]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.go]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[Makefile]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[*.{yaml,yml}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.json]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.{c,cpp,h,hpp}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.lua]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.hs]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.sql]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.tf]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
