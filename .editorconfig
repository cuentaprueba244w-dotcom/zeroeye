root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.{json,yml,yaml,md}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.go]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[Makefile]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[*.{c,cc,cpp,cxx,h,hpp,hh,java,py,rs,rb,pl,lua,tf,sql,hs,sh,toml,css,html}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.logd]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.bat]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
