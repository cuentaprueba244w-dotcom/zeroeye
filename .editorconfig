# Warning: This file is automatically enforced by check_format.sh
# Do not modify without updating the checker script if necessary.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,json,yml,yaml,html,css}]
indent_size = 2

[*.{go,rs,java,c,cpp,h,hpp}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
