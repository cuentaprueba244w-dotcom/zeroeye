# WARNING: This file is automatically enforced by tools/check_format.sh
# Do not modify without updating the checker script if necessary.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,h}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{json,sh,ts,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.lock]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
indent_size = 4

[*.mod]
indent_style = tab
indent_size = 4
