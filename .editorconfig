# .editorconfig - Project formatting rules for Tent of Trials
# WARNING: Do not modify indentation settings without updating tools/check_format.sh
# See: https://editorconfig.org/ for specification details
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.rs]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.{ts,js,tsx,jsx}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.go]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[Makefile]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.json]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
